<Window x:Class="TxtPilot.MainWindow"
        Closing="Window_Closing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        Title="MainWindow" Height="500" Width="800">

    <Window.InputBindings>
        <KeyBinding
        Key="S"
        Modifiers="Control"
        Command="{x:Static ApplicationCommands.Save}" />

        <KeyBinding
        Key="I"
        Modifiers="Control"
        Command="{x:Static ApplicationCommands.New}" />

        <KeyBinding
        Key="N"
        Modifiers="Control"
        Command="{x:Static ApplicationCommands.Open}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding
        Command="{x:Static ApplicationCommands.Save}"
        Executed="SaveCommand_Executed" />

        <CommandBinding
        Command="{x:Static ApplicationCommands.New}"
        Executed="EditCommand_Executed" />

        <CommandBinding
        Command="{x:Static ApplicationCommands.Open}"
        Executed="CreateCommand_Executed" />
    </Window.CommandBindings>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            
            <TextBlock Text="Vim Pilot"
                       FontSize="26"
                       FontWeight="Bold"/>
            
            <TextBlock Text="Blazingly fast Win-Native vim fork" 
                       Foreground="Gray"
                       Margin="0, 4, 0, 12"/>
            
            <DockPanel LastChildFill="True">
                
                <Button Content="Browse Folder"
                        DockPanel.Dock="Right"
                        Padding="16, 8"
                        Margin="8, 0, 0, 0"
                        Click="BrowseFolderButton_Click"/>
                
                <TextBox x:Name="FolderPathTextBox"
                           Height="34"
                           Padding="8"
                           VerticalAlignment="Center"
                           IsReadOnly="True"
                           Text="No Folder Selected"/>
            </DockPanel>
            
        </StackPanel>
        
        <Grid Grid.Row="1">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0, 0, 8, 0">
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Explorer"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Button Grid.Column="1"
                                x:Name="NewFileButton"
                                Content="+"
                                FontSize="15"
                                FontWeight="Bold"
                                Width="20"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="0"
                                ToolTip="Create new text file"
                                Click="NewFileButton_Click"/>
                        
                        <Button Grid.Column="2"
                                x:Name="RefreshButton"
                                Content="🔄️"
                                FontSize="15"
                                Width="20"
                                Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="0"
                                ToolTip="Refresh Explorer"
                                Click="RefreshButton_Click"/>
                    </Grid>
                    
                    <ui:ListView x:Name="FileListView" 
                              Grid.Row="1"
                              SelectionChanged="FileListView_SelectionChanged">
                        <ui:ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝"></TextBlock>
                                    <TextBlock Text="{Binding Name}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ui:ListView.ItemTemplate>
                    </ui:ListView>
                    
                </Grid>
            </Border>
            
            <Border Grid.Column="1"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="8,0,0,0">
                
                
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="File Editor"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <DockPanel Grid.Row="1"
                       LastChildFill="True"
                       Margin="0,0,0,8">

                        <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                            <Button x:Name="EditButton"
                                Content="Edit"
                                Padding="14,8"
                                Margin="8,0,4,0"
                                Click="EditButton_Click"/>

                            <Button x:Name="CancelEditButton"
                                Content="Cancel"
                                Padding="14,8"
                                Margin="4,0"
                                IsEnabled="False"
                                Click="CancelEditButton_Click"/>

                            <Button x:Name="SaveButton"
                                Content="Save"
                                Padding="14,8"
                                Margin="4,0"
                                IsEnabled="False"
                                Click="SaveButton_Click"/>

                        </StackPanel>

                        <TextBox x:Name="FileNameTextBox"
                            Padding="8"
                            VerticalContentAlignment="Center"
                            Text="No file selected"
                            IsReadOnly="True"/>

                    </DockPanel>

                    <TextBlock x:Name="FileMetadataTextBlock"
                               Grid.Row="2"
                               Text="File information will appear here"
                               Foreground="Gray"
                               Margin="0,0,0,12"/>

                    <TextBox x:Name="EditorTextBox"
                             Grid.Row="3"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="14"
                             Padding="10"
                             IsReadOnly="True"
                             TextChanged="EditorTextBox_TextChanged"
                             Text="Select a text file to view its contents."/>

                </Grid>

            </Border>
            
        </Grid>
        
        <StatusBar Grid.Row="2"
                   Margin="0,12,0,0">
            <TextBlock Text="Ready"/>
        </StatusBar>
        
        <!-- Toaster Notification popup-->
        <Border x:Name="RefreshToast"
                Grid.Row="0" Grid.RowSpan="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0, 0, 12, 45"
                Background="#252525"
                CornerRadius="8"
                Padding="16,10"
                Visibility="Collapsed">
            
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✔️"
                           Foreground="#4ADE80"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,10,0"/>
                
                <TextBlock x:Name="ToastMessage"
                           Text="Explorer Refreshed"
                           Foreground="White"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        
        
    </Grid>
    
</Window>
