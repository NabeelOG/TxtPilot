<Window x:Class="TxtPilot.FileConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Conflict"
        Height="230"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#1E1E1E"
        Foreground="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="File modified externally"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,12"/>

            <TextBlock Text="This file has been modified outside TxtPilot. What would you like to do?"
                       TextWrapping="Wrap"
                       Foreground="#CCCCCC"
                       FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Reload"
                    Padding="14,8"
                    Margin="4"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    IsDefault="True"
                    Click="ReloadButton_Click"/>

            <Button Content="Overwrite Anyway"
                    Padding="14,8"
                    Margin="4"
                    Background="#B45309"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OverwriteButton_Click"/>

            <Button Content="Cancel"
                    Padding="14,8"
                    Margin="4"
                    Background="#404040"
                    Foreground="White"
                    BorderThickness="0"
                    IsCancel="True"/>

        </StackPanel>
    </Grid>
</Window>
